DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/app
JWT_SECRET=supersecret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_OWNER_DELETE=true
PROJECTS_PAGE_SIZE_DEFAULT=10
PROJECTS_PAGE_SIZE_MAX=100
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ANALYTICS_CACHE_TTL_SECONDS=60
REDIS_URL=redis://redis:6379/0
JOBS_MAX_RETRIES=3
ANALYTICS_REFRESH_CRON=*/10 * * * *
NOTIFICATIONS_CLEANUP_CRON=0 2 * * *
THUMBNAIL_MAX_SIZE=512
THUMBNAIL_QUALITY=80
NOTIFICATIONS_RETENTION_DAYS=30
SEARCH_PAGE_SIZE_MAX=100
SEARCH_LANGUAGE=simple
INVITE_TOKEN_TTL_HOURS=72
APP_BASE_URL=http://localhost:5173
PUBLIC_API_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_TOLERANCE_SECONDS=300
OBSERVABILITY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_ENABLED=true
CSP_DEFAULT_SRC='default-src \'self\''
LOGIN_BRUTE_LIMIT_PER_MIN=5
LOGIN_BRUTE_BAN_MINUTES=10
RESET_TOKEN_TTL_MIN=30
BACKUP_CRON_DB=0 3 * * *
BACKUP_CRON_STORAGE=30 3 * * *
BACKUP_RETENTION_DAYS=7
